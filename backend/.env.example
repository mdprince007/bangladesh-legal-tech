# Copy to backend/.env and fill in.
# Free key from https://aistudio.google.com/apikey — enables the accurate handwritten-deed reader
# (two independent vision reads) and understanding of free-form scenarios.
GEMINI_API_KEY=
# Optional overrides
# DEED_VISION_MODEL=gemini-2.5-pro
# DEED_VISION_MODEL_SECONDARY=gemini-2.5-flash
# SCENARIO_MODEL=gemini-2.5-flash
# LOCAL_OCR_ENABLED=1

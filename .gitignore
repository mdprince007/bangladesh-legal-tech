# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
env/
ENV/
.venv/
env.bak/
venv.bak/

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
nosetests.xml
coverage.xml
*.cover
*.py,cover

# Node.js & Frontend
node_modules/
frontend/node_modules/
frontend/.next/
.next/
out/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment Variables & Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key

# Local Databases & Dynamic Storage
backend/legal_saas.db
backend/legal_saas.db-journal
backend/legal_saas.db-wal
backend/legal_saas.db-shm
backend/storage/*
!backend/storage/.gitkeep
learning/uploads/*
!learning/uploads/.gitkeep

# Temporary / Scratch Files
scratch/
tmp/
temp/

# IDE & OS Files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
